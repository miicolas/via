{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalDependencies": [
    ".env",
    ".env.example"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "EXPO_PUBLIC_API_URL"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "env": [
        "DATABASE_URL"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "ios": {
      "persistent": true,
      "cache": false
    },
    "android": {
      "persistent": true,
      "cache": false
    },
    "generate": {
      "cache": false,
      "env": [
        "DATABASE_URL"
      ]
    },
    "migrate": {
      "cache": false,
      "env": [
        "DATABASE_URL"
      ]
    },
    "studio": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL"
      ]
    }
  }
}
