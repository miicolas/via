{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run --filter=@via/worker typecheck",
    "watchPatterns": [
      "/apps/worker/**",
      "/packages/contract/**",
      "/packages/db/**",
      "/package.json",
      "/bun.lock",
      "/turbo.json"
    ],
    "buildEnvironment": "V3"
  },
  "deploy": {
    "runtime": "V2",
    "startCommand": "bun apps/worker/src/elevators/cli.ts",
    "preDeployCommand": [
      "bun --cwd packages/db ./node_modules/.bin/drizzle-kit migrate"
    ],
    "cronSchedule": "0 */3 * * *",
    "restartPolicyType": "NEVER"
  }
}
