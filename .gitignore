# dependencies
node_modules/

# generated output
dist/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Claude-managed worktrees are local checkouts, not repository content.
/.claude/worktrees/

# macOS
.DS_Store
*.pem

# Shared client key for the API, per developer and never committed.
apps/via/Configuration/Secrets.xcconfig

# local env files
.env
.env*.local
!.env.example

# typescript
*.tsbuildinfo

example

# turborepo
.turbo/

# Xcode
DerivedData/
*.xcuserstate
xcuserdata/
.build/

# merge/patch backups
*.orig
*.orig.*

# signing material
*.p8
*.p12
*.key
*.mobileprovision

# App Store Connect build artifacts
.asc/artifacts/

# agent worktrees
.claude/worktrees/
