{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run --filter=@via/api typecheck",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/**",
      "/package.json",
      "/bun.lock",
      "/turbo.json",
      "/patches/**"
    ],
    "buildEnvironment": "V3"
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "startCommand": "bun apps/api/src/index.ts",
    "healthcheckPath": "/api/health",
    "preDeployCommand": [
      "bun --cwd packages/db ./node_modules/.bin/drizzle-kit migrate"
    ],
    "sleepApplication": false,
    "useLegacyStacker": false,
    "ipv6EgressEnabled": false,
    "multiRegionConfig": {
      "europe-west4-drams3a": {
        "numReplicas": 1
      }
    },
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
