{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run --filter=@via/worker typecheck",
    "watchPatterns": [
      "/apps/worker/**",
      "/packages/db/**",
      "/package.json",
      "/bun.lock",
      "/turbo.json",
      "/patches/**",
      "/railway.gtfs.json"
    ]
  },
  "deploy": {
    "runtime": "V2",
    "startCommand": "bun apps/worker/src/prim/cli.ts",
    "preDeployCommand": [
      "bun --cwd packages/db ./node_modules/.bin/drizzle-kit migrate"
    ],
    "cronSchedule": "43 2 * * *",
    "restartPolicyType": "NEVER",
    "ipv6EgressEnabled": false
  }
}
