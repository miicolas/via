{
  "name": "via",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@via/api",
    "dev:mobile": "turbo run dev --filter=@via/mobile",
    "ios": "turbo run ios --filter=@via/mobile",
    "deploy:testflight": "bash scripts/deploy-testflight.sh",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:generate": "turbo run generate --filter=@via/db",
    "db:migrate": "turbo run migrate --filter=@via/db",
    "db:studio": "turbo run studio --filter=@via/db",
    "gtfs:import": "bun --env-file=.env apps/worker/src/index.ts",
    "gtfs:import:metro": "bun --env-file=.env apps/worker/src/index.ts",
    "check:transit-alignment": "bun --env-file=.env scripts/check-transit-map-alignment.ts"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "turbo": "^2.10.9",
    "typescript": "~6.0.3"
  },
  "patchedDependencies": {
    "expo-modules-jsi@57.0.4": "patches/expo-modules-jsi@57.0.4.patch"
  },
  "dependencies": {
    "expo": "^57.0.12",
    "react": "19.2.3",
    "react-native": "0.86.0"
  }
}
