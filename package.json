{
  "name": "via",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@via/api",
    "dev:mobile": "turbo run dev --filter=@via/mobile",
    "ios": "turbo run ios --filter=@via/mobile",
    "android": "turbo run android --filter=@via/mobile",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:generate": "turbo run generate --filter=@via/db",
    "db:migrate": "turbo run migrate --filter=@via/db",
    "db:seed": "turbo run seed --filter=@via/db",
    "db:studio": "turbo run studio --filter=@via/db",
    "gtfs:import:metro": "bun --env-file=.env apps/worker/src/index.ts",
    "check:transit-alignment": "bun scripts/check-transit-map-alignment.ts"
  },
  "devDependencies": {
    "turbo": "^2.10.9",
    "typescript": "~6.0.3"
  }
}
