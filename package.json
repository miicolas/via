{
  "name": "via",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@via/api",
    "ios": "xcodebuild -project apps/via/via.xcodeproj -scheme via -configuration Debug -destination 'generic/platform=iOS Simulator' build",
    "deploy:testflight": "bash scripts/deploy-testflight.sh",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:generate": "turbo run generate --filter=@via/db",
    "db:migrate": "turbo run migrate --filter=@via/db",
    "db:studio": "turbo run studio --filter=@via/db",
    "gtfs:import": "bun --env-file=.env apps/worker/src/index.ts",
    "gtfs:import:metro": "bun --env-file=.env apps/worker/src/index.ts",
    "accessibility:import": "bun --env-file=.env apps/worker/src/accessibility/cli.ts",
    "station-peaks:import": "bun --env-file=.env apps/worker/src/station-peaks/cli.ts",
    "wayfinding:import": "bun --env-file=.env apps/worker/src/wayfinding/cli.ts",
    "check:transit-alignment": "bun --env-file=.env scripts/check-transit-map-alignment.ts",
    "generate:openapi": "bun scripts/generate-openapi.ts",
    "generate:swift-client": "swift package --package-path apps/via --allow-writing-to-package-directory generate-code-from-openapi --target ViaGeneratedAPI",
    "generate:ios-api": "bun run generate:openapi && bun run generate:swift-client",
    "check:openapi": "bun scripts/generate-openapi.ts --check",
    "push:tokens": "bun --env-file=.env scripts/push-device-tokens.ts"
  },
  "devDependencies": {
    "turbo": "^2.10.9",
    "typescript": "~6.0.3"
  }
}
