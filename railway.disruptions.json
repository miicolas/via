{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run --filter=@via/api typecheck",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/**",
      "/package.json",
      "/bun.lock",
      "/turbo.json",
      "/patches/**",
      "/railway.disruptions.json"
    ]
  },
  "deploy": {
    "runtime": "V2",
    "startCommand": "bun apps/api/src/jobs/disruptions-history/cli.ts",
    "cronSchedule": "17 4 * * *",
    "restartPolicyType": "NEVER",
    "ipv6EgressEnabled": false
  }
}
