{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run --filter=@via/marketing build",
    "watchPatterns": [
      "/apps/marketing/**",
      "/packages/contract/**",
      "/package.json",
      "/bun.lock",
      "/turbo.json",
      "/patches/**",
      "/railway.marketing.json"
    ],
    "buildEnvironment": "V3"
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "startCommand": "bun run --filter=@via/marketing start",
    "healthcheckPath": "/",
    "sleepApplication": true,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
