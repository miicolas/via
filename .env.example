# Copy to .env — matches the credentials in docker-compose.yml

# Host port for the Postgres container. Bump it if 5432 is already used by
# another project on your machine, and keep DATABASE_URL in sync.
POSTGRES_PORT=5432
DATABASE_URL=postgres://via:via@localhost:5432/via

# API
# Géoplateforme (BAN) geocoder behind /api/search. Free and keyless; only
# override to point at a fake in tests.
# BAN_SEARCH_URL=https://data.geopf.fr/geocodage/search
PORT=3000

# Better Auth + Sign in with Apple. BETTER_AUTH_URL is the public origin only;
# Better Auth itself is mounted below it at /api/auth.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
APPLE_CLIENT_ID=dev.via.app
APPLE_APP_BUNDLE_IDENTIFIER=dev.via.app
APPLE_TEAM_ID=HZAYG4Q47N
APPLE_KEY_ID=
# PEM PKCS#8 contents; deployment platforms may provide newlines as literal \n.
APPLE_PRIVATE_KEY=
# Signed token emitted in `set-auth-token`, used only by the alignment script.
VIA_API_BEARER_TOKEN=

# Local Redis cache + PRIM quota counter. `bun run db:up` starts it.
# Keep REDIS_URL in sync if REDIS_PORT changes.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Realtime departures (all optional — without them /api/departures degrades to
# its fallback instead of failing).
# PRIM (prim.iledefrance-mobilites.fr) API key. New tokens: 1 000 req/day.
API_KEY_PRISM_IDFM=
# Daily ceiling the budget governor enforces; raise after PRIM grants more.
# PRIM_DAILY_BUDGET=1000
# Journey calculations use a separate counter and keep a 5% safety reserve.
# PRIM_JOURNEYS_DAILY_BUDGET=1000
# Per-person IDFM journey limit: after this window the request uses GTFS.
# PRIM_JOURNEYS_PERSONAL_LIMIT=20
# PRIM_JOURNEYS_PERSONAL_WINDOW_SECONDS=900
# PRIM_JOURNEY_PLANNER_URL=https://prim.iledefrance-mobilites.fr/marketplace/v2/navitia/journeys

# OpenAI fallback for the natural-language journey agent (POST /api/natural-journeys).
# The key stays server-side only — never ship it to the app or commit it. Without
# it the route answers the recoverable double-failure and never calls OpenAI.
OPENAI_API_KEY=
# High-volume GPT-5.6 model by default; override per environment.
# OPENAI_MODEL=gpt-5.6-luna
# Global per-submission timeout in ms (no automatic retry).
# OPENAI_TIMEOUT_MS=8000
# Per-person fallback ceiling: 20 submissions per 15-minute window.
# OPENAI_PERSONAL_LIMIT=20
# OPENAI_PERSONAL_WINDOW_SECONDS=900
# Circuit breaker: open after 5 consecutive failures, for 60 seconds.
# OPENAI_BREAKER_FAILURE_THRESHOLD=5
# OPENAI_BREAKER_OPEN_SECONDS=60
# Secret keying the safety_identifier HMAC; falls back to BETTER_AUTH_SECRET.
# OPENAI_SAFETY_SECRET=
